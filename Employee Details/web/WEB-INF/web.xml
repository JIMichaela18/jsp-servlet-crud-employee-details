<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>empinsert</servlet-name>
        <servlet-class>Employee.empinsert</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>empdelete</servlet-name>
        <servlet-class>Employee.empdelete</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>empview</servlet-name>
        <servlet-class>Employee.empview</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>empupdate</servlet-name>
        <servlet-class>Employee.empupdate</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>empinsert</servlet-name>
        <url-pattern>/empinsert</url-pattern>
    </servlet-mapping>
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
    <servlet-mapping>
        <servlet-name>empdelete</servlet-name>
        <url-pattern>/empdelete</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>empview</servlet-name>
        <url-pattern>/empview</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>empupdate</servlet-name>
        <url-pattern>/empupdate</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
